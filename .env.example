# Copy to .env locally; do not commit your filled-in .env.
NOTIF_MGMT_DB=~/.local/share/notif-mgmt/notif-mgmt.db
NOTIF_MGMT_EXCERPT_CHARS=200
# Token storage: macOS Keychain by default; set to "file" for the 0600 fallback.
NOTIF_MGMT_TOKEN_STORE=
NOTIF_MGMT_TOKEN_FILE=~/.local/share/notif-mgmt/tokens.json
GMAIL_POLL_SECONDS=300
GMAIL_OAUTH_CLIENT_JSON=./credentials.json
GMAIL_RECOVERY_DAYS=30
GMAIL_READONLY=1
GMAIL_INITIAL_QUERY=newer_than:30d
GMAIL_STORE_BODY=0
LLM_ENABLED=0
LLM_PROVIDER=meta
# Use the exact URL/model granted by your Meta hackathon, not a guessed endpoint.
LLM_BASE_URL=
LLM_MODEL=
META_API_KEY=
LLM_MAX_DAILY_REQUESTS=100
LLM_SEND_MESSAGE_CONTENT=0
